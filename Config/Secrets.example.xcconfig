// Copy to Config/Secrets.xcconfig (git-ignored), or run scripts/make-secrets.sh, which writes it
// from Config/GoogleService-Info.plist.

// REVERSED_CLIENT_ID from GoogleService-Info.plist (com.googleusercontent.apps.<numbers>-<id>).
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.000000000000-example

// NO only when building for a device with a free Apple team (no Sign in with Apple).
// ENABLE_APPLE_SIGN_IN = NO
